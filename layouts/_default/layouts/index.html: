{{ define "main" }}
<div class="max-w-6xl mx-auto my-6 px-4">

  <!-- Ambil semua postingan berita kecuali halaman statis (pages) -->
  {{ $pages := where .Site.RegularPages "Type" "posts" }}


  <!-- 1. HEADLINE / ARTIKEL UTAMA (Paling Baru) -->
  {{ range first 1 $pages }}
  <section class="mb-10">
    <div class="bg-white rounded-xl shadow-md overflow-hidden grid grid-cols-1 md:grid-cols-2 hover:shadow-lg transition border border-gray-100">
      <div class="h-64 md:h-auto bg-gray-200">
        {{ with .Params.featured_image }}
          <img src="{{ . | relURL }}" alt="{{ $.Title }}" class="w-full h-full object-cover">
        {{ else }}
          <div class="w-full h-full flex items-center justify-center text-gray-400 font-semibold">Berita Utama</div>
        {{ end }}
      </div>
      <div class="p-6 flex flex-col justify-between">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600">Terbaru</span>
          <h2 class="text-2xl md:text-3xl font-bold mt-2 text-gray-900 leading-tight">
            <a href="{{ .RelPermalink }}" class="hover:text-blue-600 transition">{{ .Title }}</a>
          </h2>
          <p class="text-gray-600 mt-3 text-sm line-clamp-3">
            {{ .Summary | plainify }}
          </p>
        </div>
        <div class="mt-4 flex items-center text-xs text-gray-500 gap-3 border-t pt-3">
          <span>📅 {{ .Date.Format "02 Jan 2006" }}</span>
          <span>•</span>
          <span>✍️ {{ .Params.author | default .Site.Params.author }}</span>
        </div>
      </div>
    </div>
  </section>
  {{ end }}

  <!-- 2. GRID ARTIKEL LAINNYA (2 Kolom) + SIDEBAR (1 Kolom) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    
    <div class="md:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-6">
      {{ range after 1 $pages }}
      <article class="bg-white rounded-lg shadow hover:shadow-md transition overflow-hidden flex flex-col justify-between border border-gray-100">
        <div>
          <a href="{{ .RelPermalink }}" class="block h-44 bg-gray-200 overflow-hidden">
            {{ with .Params.featured_image }}
              <img src="{{ . | relURL }}" alt="{{ $.Title }}" class="w-full h-full object-cover hover:scale-105 transition duration-300">
            {{ else }}
              <div class="w-full h-full flex items-center justify-center text-gray-400 text-xs">Foto Artikel</div>
            {{ end }}
          </a>
          <div class="p-4">
            <h3 class="font-bold text-lg text-gray-900 leading-snug line-clamp-2">
              <a href="{{ .RelPermalink }}" class="hover:text-blue-600 transition">{{ .Title }}</a>
            </h3>
            <p class="text-gray-600 text-xs mt-2 line-clamp-2">
              {{ .Summary | plainify }}
            </p>
          </div>
        </div>
        <div class="p-4 pt-0 text-xs text-gray-400 border-t border-gray-50 mt-2 flex justify-between items-center">
          <span>{{ .Date.Format "02 Jan 2006" }}</span>
          <a href="{{ .RelPermalink }}" class="text-blue-600 font-medium hover:underline">Baca →</a>
        </div>
      </article>
      {{ end }}
    </div>

    <!-- Sidebar Samping -->
    <aside class="space-y-6">
      <div class="bg-white p-5 rounded-lg shadow border border-gray-100">
        <h3 class="font-bold text-gray-900 border-b pb-2 mb-3 text-sm uppercase tracking-wider text-blue-600">📌 Sekilas Info</h3>
        <p class="text-xs text-gray-600 leading-relaxed">
          Selamat datang di portal informasi resmi <b>teukuanca.com</b>. Dapatkan pembaruan berita dan artikel terbaru di sini.
        </p>
      </div>
    </aside>

  </div>

</div>
{{ end }}
