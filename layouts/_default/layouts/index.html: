{{ define "main" }}
<div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold mb-6 border-b pb-2">Artikel Terkini</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {{ range where .Site.RegularPages "Section" "posts" }}
        <article class="bg-white rounded-lg shadow-md overflow-hidden flex flex-col justify-between hover:shadow-lg transition-shadow">
            <div>
                <!-- Gambar Sampul -->
                {{ with .Params.featured_image }}
                <a href="{{ $.RelPermalink }}">
                    <img src="{{ . }}" alt="{{ $.Title }}" class="w-full h-48 object-cover">
                </a>
                {{ end }}

                <div class="p-5">
                    <!-- Judul Artikel -->
                    <h2 class="text-xl font-semibold mb-2 line-clamp-2">
                        <a href="{{ .RelPermalink }}" class="text-gray-900 hover:text-blue-600">
                            {{ .Title }}
                        </a>
                    </h2>

                    <!-- Ringkasan Singkat -->
                    <p class="text-gray-600 text-sm mb-4 line-clamp-3">
                        {{ .Description | default .Summary }}
                    </p>
                </div>
            </div>

            <!-- Tombol Baca Selengkapnya -->
            <div class="px-5 pb-5">
                <a href="{{ .RelPermalink }}" class="inline-block bg-blue-600 text-white text-sm font-medium px-4 py-2 rounded hover:bg-blue-700 transition-colors">
                    Baca Selengkapnya &rarr;
                </a>
            </div>
        </article>
        {{ range else }}
        <p class="text-gray-500">Belum ada artikel yang dipublikasikan.</p>
        {{ end }}
    </div>
</div>
{{ end }}
