<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ .Title }}</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="bg-gray-100 text-gray-800">

  <!-- Navigasi / Header Baru (Nama di atas, Menu & Sub-menu di bawah) -->
  <header class="bg-blue-600 text-white p-4 shadow">
    <div class="max-w-6xl mx-auto flex flex-col items-center md:items-start gap-3">
      
      <!-- 1. Nama Situs di Atas -->
      <a href="/" class="text-2xl font-bold tracking-wide hover:opacity-90">
        {{ .Site.Title }}
      </a>

      <!-- 2. Baris Menu di Bawah Nama Situs -->
      <nav class="w-full border-t border-blue-500 pt-2">
        <ul class="flex flex-wrap justify-center md:justify-start gap-6 text-sm font-medium">
          {{ range .Site.Menus.main }}
            
            {{ if .HasChildren }}
              <!-- Menu dengan Sub-menu (Dropdown) -->
              <li class="relative group cursor-pointer py-1">
                <span class="hover:text-blue-200 flex items-center gap-1">
                  {{ .Name }} ▼
                </span>
                <ul class="absolute left-0 hidden group-hover:block bg-white text-gray-800 mt-1 py-2 w-40 rounded shadow-lg z-50">
                  {{ range .Children }}
                    <li>
                      <a href="{{ .URL }}" class="block px-4 py-2 hover:bg-blue-50 hover:text-blue-600">
                        {{ .Name }}
                      </a>
                    </li>
                  {{ end }}
                </ul>
              </li>
            {{ else }}
              <!-- Menu Biasa -->
              <li class="py-1">
                <a href="{{ .URL }}" class="hover:text-blue-200">
                  {{ .Name }}
                </a>
              </li>
            {{ end }}

          {{ end }}
        </ul>
      </nav>

    </div>
  </header>

  <!-- Konten Utama & Sidebar -->
  <main class="max-w-6xl mx-auto p-4 grid grid-cols-1 md:grid-cols-3 gap-6 my-6">
    
    <!-- Area Artikel Utama -->
    <article class="md:col-span-2 bg-white p-6 rounded-lg shadow">
      <h2 class="text-2xl font-bold mb-4">{{ .Title }}</h2>
      <div class="prose max-w-none">
        {{ .Content }}
      </div>
    </article>

    <!-- Sidebar / Info Samping -->
    <aside class="bg-white p-6 rounded-lg shadow h-fit">
      <h3 class="font-bold text-lg mb-2">Informasi</h3>
      <p class="text-sm text-gray-600">Ini adalah sidebar yang akan berada di samping saat dibuka di PC, dan turun ke bawah saat dibuka di HP.</p>
    </aside>

  </main>

</body>
</html>
