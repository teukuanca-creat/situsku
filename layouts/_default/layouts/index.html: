{{ define "main" }}
<div class="max-w-6xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-6 border-b pb-2 text-gray-800">Artikel Terbaru</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- AMBIL HANYA ARTIKEL DI FOLDER POSTS -->
        {{ range (where .Site.RegularPages "Section" "posts") }}
        <article class="bg-white border rounded-lg overflow-hidden shadow-sm flex flex-col justify-between hover:shadow-md transition">
            <div>
                {{ if .Params.featured_image }}
                <a href="{{ .RelPermalink }}">
                    <img src="{{ .Params.featured_image }}" alt="{{ .Title }}" class="w-full h-48 object-cover">
                </a>
                {{ else if .Params.image }}
                <a href="{{ .RelPermalink }}">
                    <img src="{{ .Params.image }}" alt="{{ .Title }}" class="w-full h-48 object-cover">
                </a>
                {{ end }}

                <div class="p-4">
                    <h2 class="font-bold text-lg mb-2 leading-tight">
                        <a href="{{ .RelPermalink }}" class="text-gray-900 hover:text-blue-600">
                            {{ .Title }}
                        </a>
                    </h2>
                    <p class="text-xs text-gray-400 mb-2">{{ .Date.Format "02 Jan 2006" }}</p>
                    <p class="text-sm text-gray-600 line-clamp-3">
                        {{ .Summary | plainify }}
                    </p>
                </div>
            </div>

            <div class="p-4 pt-0">
                <a href="{{ .RelPermalink }}" class="inline-block bg-blue-600 text-white text-xs font-semibold px-3 py-2 rounded hover:bg-blue-700">
                    Baca Selengkapnya &rarr;
                </a>
            </div>
        </article>
        {{ else }}
        <p class="col-span-3 text-gray-500">Tidak ada artikel ditemukan di folder content/posts.</p>
        {{ end }}
    </div>
</div>
{{ end }}
