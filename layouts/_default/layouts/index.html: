{{ define "main" }}
<div class="max-w-6xl mx-auto px-6 py-8">
    <div class="flex flex-col lg:flex-row gap-10">
        
        <!-- KOLOM KIRI: POSTINGAN ARTIKEL UTAMA -->
        <main class="lg:w-2/3">
            <h1 class="text-2xl font-bold mb-6 border-b-2 border-blue-600 pb-2">Artikel Terkini</h1>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- PENTING: .Site.RegularPages khusus mengambil artikel postingan saja, mengabaikan folder "pages" dan halaman arsip -->
                {{ range where .Site.RegularPages "Section" "posts" }}
                <article class="bg-white rounded-lg shadow-sm overflow-hidden flex flex-col justify-between hover:shadow-md transition">
                    <div>
                        <!-- Gambar Sampul -->
                        {{ with .Params.featured_image }}
                        <a href="{{ $.RelPermalink }}">
                            <img src="{{ . }}" alt="{{ $.Title }}" class="w-full h-44 object-cover">
                        </a>
                        {{ end }}

                        <div class="p-5">
                            <!-- Judul Artikel -->
                            <h2 class="text-lg font-bold mb-2 leading-tight">
                                <a href="{{ .RelPermalink }}" class="text-gray-900 hover:text-blue-600 transition-colors">
                                    {{ .Title }}
                                </a>
                            </h2>

                            <p class="text-gray-400 text-xs mb-3">{{ .Date.Format "02 Jan 2006" }}</p>

                            <!-- Ringkasan Singkat -->
                            <p class="text-gray-600 text-sm line-clamp-3">
                                {{ .Description | default .Summary }}
                            </p>
                        </div>
                    </div>

                    <!-- Tombol Baca Selengkapnya -->
                    <div class="px-5 pb-5">
                        <a href="{{ .RelPermalink }}" class="inline-block bg-blue-600 text-white text-xs font-semibold px-4 py-2 rounded hover:bg-blue-700 transition-colors">
                            Baca Selengkapnya &rarr;
                        </a>
                    </div>
                </article>
                {{ range else }}
                <p class="text-gray-500 col-span-2">Belum ada artikel yang dipublikasikan di folder posts.</p>
                {{ end }}
            </div>
        </main>

        <!-- KOLOM KANAN: SIDEBAR (Kategori & Populer) -->
        <aside class="lg:w-1/3 space-y-8">
            
            <!-- Widget Kategori -->
            <div class="bg-white p-5 rounded-lg shadow-sm border border-gray-100">
                <h3 class="font-bold text-base mb-4 border-b pb-2 text-gray-800">Kategori</h3>
                <ul class="space-y-2 text-sm text-gray-600">
                    {{ range $name, $items := .Site.Taxonomies.categories }}
                    <li>
                        <a href="/categories/{{ $name | urlize }}" class="hover:text-blue-600 flex justify-between items-center">
                            <span class="capitalize"># {{ $name }}</span>
                            <span class="bg-gray-100 text-gray-500 text-xs px-2 py-0.5 rounded-full">{{ len $items }}</span>
                        </a>
                    </li>
                    {{ range else }}
                    <li class="text-xs text-gray-400">Belum ada kategori.</li>
                    {{ end }}
                </ul>
            </div>

            <!-- Widget Artikel Populer/Terbaru -->
            <div class="bg-white p-5 rounded-lg shadow-sm border border-gray-100">
                <h3 class="font-bold text-base mb-4 border-b pb-2 text-gray-800">Postingan Terbaru</h3>
                <ul class="space-y-4">
                    {{ range first 4 (where .Site.RegularPages "Section" "posts") }}
                    <li class="flex gap-3 items-center">
                        {{ with .Params.featured_image }}
                        <img src="{{ . }}" class="w-14 h-14 object-cover rounded flex-shrink-0">
                        {{ end }}
                        <div>
                            <a href="{{ .RelPermalink }}" class="text-xs font-medium text-gray-800 hover:text-blue-600 line-clamp-2 leading-snug">
                                {{ .Title }}
                            </a>
                            <span class="text-[10px] text-gray-400 block mt-1">{{ .Date.Format "02 Jan 2006" }}</span>
                        </div>
                    </li>
                    {{ end }}
                </ul>
            </div>

        </aside>

    </div>
</div>
{{ end }}
